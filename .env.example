# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string.
# In production, use a managed DB (Render, Supabase, Neon) and ensure the
# host enforces SSL — the app will require SSL for any non-localhost URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/note2test

# Set to "true" to force SSL even when connecting to localhost (useful for
# testing against a remote DB in dev without changing NODE_ENV).
DATABASE_SSL=false

# ── Clerk authentication ───────────────────────────────────────────────────────
# Found at: https://dashboard.clerk.com → API Keys
# NEVER commit the real value — use your platform's secret manager.
CLERK_SECRET_KEY=sk_test_...

# Found at: Clerk Dashboard → Webhooks → your endpoint → Signing Secret.
# Only required if you use Clerk webhooks. Leave blank to disable the endpoint.
CLERK_WEBHOOK_SECRET=whsec_...

# ── Admin access ──────────────────────────────────────────────────────────────
# Comma-separated list of email addresses that are auto-promoted to admin on
# first sign-in. Every promotion is audit-logged.
# Example: ADMIN_EMAIL=alice@example.com,bob@example.com
ADMIN_EMAIL=

# ── AI providers ──────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...

# URL of a local Ollama instance (optional — leave blank if not used).
OLLAMA_URL=http://localhost:11434

# ── Server ────────────────────────────────────────────────────────────────────
PORT=2001
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production, set this to your exact frontend URL (no trailing slash).
# Example: FRONTEND_URL=https://app.example.com
FRONTEND_URL=http://localhost:5173

# ── Object storage (Backblaze B2 / S3-compatible) ─────────────────────────────
STORAGE_PROVIDER=local
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
